# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server — webhook + cron only)
SUPABASE_SERVICE_ROLE_KEY=

# Webhook auth (Google Apps Script → CRM)
WEBHOOK_SECRET=

# Cron auth (Vercel Cron → CRM)
CRON_SECRET=

# Web Push (task reminders on phone)
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@anandprime.com

# Google Sheets (connected sheet: Leads + Inventory tabs, two-way sync)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_LEADS_TAB=Leads
GOOGLE_SHEET_INVENTORY_TAB=Inventory
GOOGLE_SERVICE_ACCOUNT_JSON=
