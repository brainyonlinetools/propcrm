# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server — cron only)
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth (Vercel Cron → CRM)
CRON_SECRET=

# Web Push (task reminders on phone)
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@anandprime.com

# Voice notes (server-only keys). VOICE_API_SECRET and NEXT_PUBLIC_VOICE_API_SECRET must be the same random string.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
VOICE_API_SECRET=
NEXT_PUBLIC_VOICE_API_SECRET=
